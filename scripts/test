#!/bin/bash
set -e

NFS_SERVER=backupstore_nfs_test_server
NFS_PATH="/opt/backupstore"

if [[ ! -z $(docker ps -a | grep "${NFS_SERVER}") ]]; then
        docker rm -f "${NFS_SERVER}"
fi

function cleanup {
        echo Unmounting NFS Share
        if [[ -n "${NFS_IPADDR:-}" ]]; then
                mount -l | awk -v ip="${NFS_IPADDR}" '$1 ~ ip && $3 ~ /^\/var\/lib\/longhorn-backupstore-mounts\// {print $3}' | xargs -r -n1 umount || true
        fi
        echo Stopping NFS server
        docker rm -vf "$NFS_SERVER" || true
}
trap cleanup EXIT

cd $(dirname $0)/..

echo Starting NFS server

docker pull longhornio/nfs-backupstore:latest
docker run -d --name "$NFS_SERVER" --privileged longhornio/nfs-backupstore:latest \
        /bin/bash -c 'mkdir -p /usr/local/var/lib/nfs/ganesha && exec /opt/start_nfs.sh'

export NFS_IPADDR=`docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' ${NFS_SERVER}`

ready=false
for i in {1..30}; do
        if [[ "$(docker inspect -f '{{.State.Running}}' "$NFS_SERVER")" != "true" ]]; then
                docker logs "$NFS_SERVER"
                echo "NFS server exited before tests started" >&2
                exit 1
        fi
        if docker logs "$NFS_SERVER" 2>&1 | grep -q 'NFS SERVER INITIALIZED'; then
                ready=true
                break
        fi
        sleep 1
done
if [[ "$ready" != true ]]; then
        docker logs "$NFS_SERVER"
        echo "NFS server did not become ready" >&2
        exit 1
fi

echo Running tests

PACKAGES="$(find -name '*.go' | xargs -I{} dirname {} |  cut -f2 -d/ | sort -u | grep -Ev '(^\.$|.git|.trash-cache|vendor|bin)' | sed -e 's!^!./!' -e 's!$!/...!')"

go test -race -cover ${PACKAGES} -coverprofile=coverage.out

